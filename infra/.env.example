# ==============================================================================
# Environment Configuration (.env.example)
# Copy this file to .env to override defaults for local development.
# NOTE: .env is gitignored to prevent committing real secrets.
# ==============================================================================

# SQL Server Configuration
MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2025-latest
MSSQL_SA_PASSWORD=YourStrong@Passw0rd
MSSQL_PORT=1433

# RabbitMQ Configuration
RABBITMQ_USER=organizer
RABBITMQ_PASS=organizer_secret
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Application Ports
APP_HOST_PORT=5000
PROCESSING_HOST_PORT=5001
JAEGER_UI_PORT=16686
