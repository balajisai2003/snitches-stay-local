# ==============================================================================
# Environment Configuration (.env.example)
# Copy this file to .env to override defaults for local development.
# NOTE: .env is gitignored to prevent committing real secrets.
# ==============================================================================

# PostgreSQL + pgvector Configuration
POSTGRES_IMAGE=pgvector/pgvector:pg16
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=organizer
POSTGRES_PORT=5432

# RabbitMQ Configuration
RABBITMQ_USER=organizer
RABBITMQ_PASS=organizer_secret
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Application Ports
APP_HOST_PORT=5050
PROCESSING_HOST_PORT=5051
JAEGER_UI_PORT=16686

